# Optional. The default is %LOCALAPPDATA%\MangaTranslator on Windows.
# Use a writable, dedicated directory. Do not put API keys in this file.
MANGA_TRANSLATOR_DATA_DIR=

# Logging and local task concurrency.
MANGA_TRANSLATOR_LOG_LEVEL=INFO
MANGA_TRANSLATOR_IMPORT_CONCURRENCY=1
MANGA_TRANSLATOR_UPLOAD_CONCURRENCY=2
MANGA_TRANSLATOR_OCR_CONCURRENCY=2
MANGA_TRANSLATOR_LLM_CONCURRENCY=3
MANGA_TRANSLATOR_VLM_CONCURRENCY=2
MANGA_TRANSLATOR_LLM_MAX_RETRIES=3
MANGA_TRANSLATOR_LLM_RETRY_BASE_SECONDS=1

# Generated image sizes (pixels). Source images are never resized in place.
MANGA_TRANSLATOR_THUMBNAIL_SIZE=220
MANGA_TRANSLATOR_PREVIEW_SIZE=1600

# Import, archive and model safety limits.
MANGA_TRANSLATOR_UPLOAD_SESSION_TTL_HOURS=24
MANGA_TRANSLATOR_MAX_ARCHIVE_ENTRIES=10000
# 20 GiB decompressed import limit.
MANGA_TRANSLATOR_MAX_IMPORT_BYTES=21474836480
MANGA_TRANSLATOR_MAX_COMPRESSION_RATIO=200
# 2 GiB maximum locally registered model file.
MANGA_TRANSLATOR_MAX_MODEL_BYTES=2147483648
