{
  "name": "manga-translator-frontend",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "format": "prettier --write src e2e *.ts *.json",
    "format:check": "prettier --check src e2e *.ts *.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.9",
    "element-plus": "^2.9.1",
    "konva": "^10.5.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-konva": "^4.0.1",
    "vue-router": "^4.5.0",
    "vue-virtual-scroller": "^2.0.0-beta.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.6",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.0"
  },
  "packageManager": "pnpm@11.19.0"
}
